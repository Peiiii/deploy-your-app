{
  "name": "gemigo-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "adb27b39051202962038992eeaf8f6bb",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "admin.gemigo.io",
      "custom_domain": true,
    },
  ],
  "vars": {
    "ADMIN_USERNAME": "admin",
    "CLOUDFLARE_ACCOUNT_ID": "adb27b39051202962038992eeaf8f6bb",
    "GROWTH_PLATFORM_SITE_TAG": "e1b2c8f916f44dc584d9f69895caea30",
    "GROWTH_APPS_SITE_TAG": "949abcc33d7043af99338da86662a19b",
  },
  "assets": {
    "directory": "../../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "gemigo-projects",
      "database_id": "e1e28d75-d0a0-4f8e-9b5d-714454686a4f",
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
}
