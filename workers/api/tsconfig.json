{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "WebWorker",
      "DOM.Iterable"
    ],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "references": [
    {
      "path": "../../packages/product-analytics"
    },
    {
      "path": "../../packages/deployment-assets"
    },
    {
      "path": "../../packages/notifications"
    },
    {
      "path": "../../packages/public-author"
    }
  ]
}
